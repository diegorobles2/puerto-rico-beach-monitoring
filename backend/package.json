{
  "name": "puerto-rico-beach-monitoring-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "db:migrate": "knex migrate:latest --knexfile knexfile.ts",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "db:verify": "ts-node src/database/verify-schema.ts",
    "ingest": "ts-node src/ingestion/run-ingestion.ts",
    "ingest:nws": "ts-node src/ingestion/run-nws-ingestion.ts",
    "map:nws": "ts-node src/ingestion/run-nws-mapping.ts",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:load": "k6 run ../tests/load/beaches.js",
    "seed:load": "ts-node src/database/seed-load-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^18.0.5",
    "knex": "^3.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
